# 本地开发用：复制为 .dev.vars 并填写（不会被提交）。
# 生产环境请用 wrangler secret put 或 Cloudflare 控制台 Secrets 配置同名变量。
CARD_ADMIN_KEY=replace-with-a-long-random-string
CARD_SESSION_SECRET=replace-with-another-long-random-string
VOLC_ACCESS_KEY_ID=your_volc_access_key_id
VOLC_SECRET_ACCESS_KEY=your_volc_secret_access_key
ALLOWED_ORIGINS=
CLIENT_ORIGIN=https://pixelbeans.pages.dev
COOKIE_SECURE=true
